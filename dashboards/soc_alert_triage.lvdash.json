{
  "datasets": [
    {
      "name": "ds_kpis",
      "displayName": "KPIs",
      "queryLines": [
        "SELECT COUNT(*) AS total_alerts, ",
        "  SUM(CASE WHEN e.risk_tier = 'critical' THEN 1 ELSE 0 END) AS critical_alerts, ",
        "  SUM(CASE WHEN e.is_true_positive THEN 1 ELSE 0 END) AS real_threats, ",
        "  ROUND(AVG(CASE WHEN e.is_true_positive THEN CASE WHEN p.ml_predicted_severity IN ('critical','high') THEN 1.0 ELSE 0.0 END END) * 100, 1) AS pct_threats_prioritized, ",
        "  ROUND(AVG(CASE WHEN p.ml_predicted_severity IN ('informational','low') THEN 1.0 ELSE 0.0 END) * 100, 1) AS pct_deprioritizable, ",
        "  (SELECT ROUND(AVG(time_to_triage_seconds) / 60, 1) FROM rajarora_febar.soc_alert_triage.analyst_actions) AS avg_triage_minutes ",
        "FROM rajarora_febar.soc_alert_triage.gold_enriched_alerts e JOIN rajarora_febar.soc_alert_triage.gold_alert_predictions p ON e.event_id = p.event_id "
      ]
    },
    {
      "name": "ds_daily",
      "displayName": "Daily alerts",
      "queryLines": [
        "SELECT e.event_date, e.source_type, e.risk_tier, p.ml_predicted_severity, ",
        "  COUNT(*) AS alerts, ",
        "  SUM(CASE WHEN e.threat_intel_match THEN 1 ELSE 0 END) AS threat_intel_matches, ",
        "  SUM(CASE WHEN e.is_true_positive THEN 1 ELSE 0 END) AS real_threats, ",
        "  SUM(CASE WHEN e.is_true_positive AND p.ml_predicted_severity IN ('critical','high') THEN 1 ELSE 0 END) AS real_threats_prioritized ",
        "FROM rajarora_febar.soc_alert_triage.gold_enriched_alerts e JOIN rajarora_febar.soc_alert_triage.gold_alert_predictions p ON e.event_id = p.event_id ",
        "GROUP BY e.event_date, e.source_type, e.risk_tier, p.ml_predicted_severity "
      ]
    },
    {
      "name": "ds_customers",
      "displayName": "Customers",
      "queryLines": [
        "SELECT customer_id, customer_name, industry, tier, ",
        "  COUNT(*) AS alerts, ",
        "  SUM(CASE WHEN risk_tier = 'critical' THEN 1 ELSE 0 END) AS critical_alerts, ",
        "  SUM(CASE WHEN risk_tier IN ('critical','high') THEN 1 ELSE 0 END) AS high_risk_alerts, ",
        "  SUM(CASE WHEN threat_intel_match THEN 1 ELSE 0 END) AS threat_intel_matches, ",
        "  ROUND(AVG(composite_risk_score), 2) AS avg_risk_score ",
        "FROM rajarora_febar.soc_alert_triage.gold_enriched_alerts ",
        "GROUP BY customer_id, customer_name, industry, tier "
      ]
    },
    {
      "name": "ds_top_customers",
      "displayName": "Top 10 customers",
      "queryLines": [
        "SELECT customer_name, COUNT(*) AS critical_alerts ",
        "FROM rajarora_febar.soc_alert_triage.gold_enriched_alerts WHERE risk_tier = 'critical' ",
        "GROUP BY customer_id, customer_name ORDER BY critical_alerts DESC LIMIT 10 "
      ]
    },
    {
      "name": "ds_mitre",
      "displayName": "MITRE tactics (EDR)",
      "queryLines": [
        "SELECT mitre_tactic, risk_tier, COUNT(*) AS alerts ",
        "FROM rajarora_febar.soc_alert_triage.gold_enriched_alerts WHERE source_type = 'edr' AND mitre_tactic IS NOT NULL ",
        "GROUP BY mitre_tactic, risk_tier "
      ]
    },
    {
      "name": "ds_fp_by_source",
      "displayName": "FP rate by source",
      "queryLines": [
        "SELECT source_type, ",
        "  COUNT(*) AS triaged_alerts, ",
        "  ROUND(AVG(CASE WHEN triage_outcome IN ('false_positive','benign') THEN 1.0 ELSE 0.0 END) * 100, 1) AS fp_rate_pct ",
        "FROM rajarora_febar.soc_alert_triage.historical_triage_decisions GROUP BY source_type "
      ]
    },
    {
      "name": "ds_analysts",
      "displayName": "Analyst performance",
      "queryLines": [
        "SELECT analyst_id, ",
        "  COUNT(*) AS actions, ",
        "  ROUND(AVG(time_to_triage_seconds) / 60, 1) AS avg_triage_minutes, ",
        "  ROUND(PERCENTILE(time_to_triage_seconds, 0.95) / 60, 1) AS p95_triage_minutes, ",
        "  SUM(CASE WHEN action_type = 'escalate' THEN 1 ELSE 0 END) AS escalations, ",
        "  SUM(CASE WHEN action_type = 'false_positive' THEN 1 ELSE 0 END) AS false_positives ",
        "FROM rajarora_febar.soc_alert_triage.analyst_actions GROUP BY analyst_id "
      ]
    }
  ],
